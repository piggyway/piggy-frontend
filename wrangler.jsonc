{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "piggy-frontend",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "piggy-frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "piggyway.com.au/*", "zone_name": "piggyway.com.au" },
    { "pattern": "www.piggyway.com.au/*", "zone_name": "piggyway.com.au" }
  ]
  // Optional: Next.js incremental cache on R2
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "piggy-frontend-next-cache"
  //   }
  // ]
}
