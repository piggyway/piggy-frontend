{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "piggy-frontend",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "piggy-frontend",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  // Non-secret runtime vars. Secrets (API_BASE_URL, NEXTAUTH_*, GOOGLE_*,
  // STRIPE_SECRET_KEY) are managed in the dashboard and survive deploys.
  // NEXT_PUBLIC_* values must also be set as build variables in the
  // Workers Builds settings so `next build` can inline them.
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://api.piggyway.com.au",
    "NEXT_PUBLIC_APP_ENV": "production",
    "NEXT_PUBLIC_APP_URL": "https://piggyway.com.au",
    "NEXT_PUBLIC_SITE_URL": "https://piggyway.com.au",
  },
  "routes": [
    { "pattern": "piggyway.com.au", "custom_domain": true },
    { "pattern": "piggyway.com.au/*", "zone_name": "piggyway.com.au" },
    { "pattern": "www.piggyway.com.au/*", "zone_name": "piggyway.com.au" },
  ],
  // Optional: Next.js incremental cache on R2
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "piggy-frontend-next-cache"
  //   }
  // ]
}
