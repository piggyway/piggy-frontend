# Server-side secrets
STRIPE_SECRET_KEY=
API_BASE_URL=http://localhost:3000


# Client-side env (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=https://piggyway.com.au

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional
# PORT=3000

# NextAuth Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Directus Live Preview
PREVIEW_SECRET=piggyway-preview-secret

# Error reporting (optional). Leave both empty to disable it entirely.
# SENTRY_DSN is read on the server, NEXT_PUBLIC_SENTRY_DSN in the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Shared secret sent to the backend so it trusts the forwarded client IP.
# Must match INTERNAL_PROXY_SECRET on the backend.
INTERNAL_PROXY_SECRET=piggyway-internal-proxy-secret
